# Copy to .env for local, or set these in cPanel > Setup Node.js App > Environment variables.

# Signing key for the age-gate cookie. Use a long random string in production.
ROOK_SECRET=change-me-to-a-long-random-string

# Where the waitlist + messages files are written. On cPanel, point this at a
# folder OUTSIDE the app directory so a redeploy does not wipe your signups,
# e.g. /home/youruser/rook-data
ROOK_DATA_DIR=

# Set by the host in production; leave unset locally (defaults to 3000).
# PORT=

NODE_ENV=production
