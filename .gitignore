node_modules/
# ANCHORED. Unanchored 'data/' matches a directory called data at ANY depth,
# which silently excluded src/data/ - the entire content layer of the site.
# Every word of copy went untracked for weeks, and a deploy that shipped a
# tracked page importing from an untracked data file took the site down.
/data/
.env
*.log

# build workspace: keep the generator, not the heavy source assets
.build/*.ttf
.build/*.png

# Passenger's restart trigger, created by the .cpanel.yml deploy task itself.
# It must be ignored: cPanel refuses to deploy unless the checked-out branch
# is clean, so a deploy that left this behind would block the next one.
tmp/
